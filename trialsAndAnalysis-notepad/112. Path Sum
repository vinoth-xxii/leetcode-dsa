class Solution {
    public boolean helper(TreeNode node, int targetSum, int sum){
        boolean matched = false;
        
        if(node.left == null && node.right == null){ //if the node is leaf
            sum+=node.val;
            if(targetSum == sum) return true;
        }
        
        sum+=node.val;
        if(node.left != null) {  //if it's left then we have some path to explore
            matched = helper(node.left, targetSum, sum);
        }
        if(node.right != null && !matched){
            matched = helper(node.right, targetSum, sum);
        }

        return matched;
    }

    public boolean hasPathSum(TreeNode root, int targetSum) {
        if(root == null) return false;
        return helper(root, targetSum, 0);
    }
}